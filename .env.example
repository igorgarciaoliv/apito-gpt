# .env.example — Arquivo de configuração da API OpenAI
# 
# Crie um arquivo .env na raiz do projeto com sua chave:
#   cp .env.example .env
#   # edite .env e adicione sua chave

# Chave da API OpenAI (obtenha em https://platform.openai.com/api-keys)
# ⚠️  NUNCA compartilhe ou publique sua chave!
OPENAI_API_KEY=sk-...seu-token-aqui...

# Modelo de geração. O padrão é gpt-4o: as Regras do Jogo têm muita punição
# condicionada à intensidade da infração, e o mini erra mais nesses casos.
# Alternativas:
#   - gpt-4o      (padrão — melhor raciocínio normativo)
#   - gpt-4o-mini (mais barato; perde precisão em regras condicionais)
OPENAI_MODEL=gpt-4o
